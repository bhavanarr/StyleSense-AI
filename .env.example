# Copy to .env.local and fill in. NEVER commit real keys.
# Milestone 1 needs none of these; the app runs on built-in demo data.

# Supabase (Day 3). The anon key is safe in the browser ONLY because Row Level Security is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
TRYON_PROVIDER=none
TRYON_API_KEY=
