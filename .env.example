# Copy to .env.local and fill in. NEVER commit real keys.
# The stylist works with built-in rules if GEMINI_API_KEY is missing.

# Supabase (Day 3). The anon key is safe in the browser ONLY because Row Level Security is on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix with NEXT_PUBLIC_). Used only by the API route.
GEMINI_API_KEY=
TRYON_PROVIDER=none
TRYON_API_KEY=
